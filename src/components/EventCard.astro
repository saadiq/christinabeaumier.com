---
interface Props {
  event: string;
  title: string;
  date: string;
  location?: string;
  role?: string;
  titleSize?: 'lg' | 'xl';
}

const { event, title, date, location, role, titleSize = 'lg' } = Astro.props;
const titleClass = titleSize === 'xl' ? 'text-xl' : 'text-lg';
---

<div class="group rounded-xl border border-cream-200 bg-white p-6 shadow-sm transition-all duration-300 hover:-translate-y-0.5 hover:shadow-md">
  <span class="text-sm font-semibold uppercase tracking-wider text-gold-600">
    {event}
  </span>
  <h3 class:list={[titleClass, 'mt-2 font-semibold leading-snug text-warm-gray-900']}>
    {title}
  </h3>
  {role && (
    <span class="mt-2 inline-block rounded-full bg-gold-500/10 px-2.5 py-0.5 text-xs font-medium text-gold-700">
      {role}
    </span>
  )}
  <div class="mt-4 flex flex-wrap items-center gap-x-4 gap-y-1 text-sm text-warm-gray-500">
    <span>{date}</span>
    {location && (
      <span class="flex items-center gap-1">
        <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
        </svg>
        {location}
      </span>
    )}
  </div>
</div>
