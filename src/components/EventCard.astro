---
interface Props {
  event: string;
  title: string;
  date: string;
  location?: string;
  role?: string;
  url?: string;
  titleSize?: 'lg' | 'xl';
  type?: 'panel' | 'interview' | 'presentation';
}

const { event, title, date, location, role, url, titleSize = 'lg', type } = Astro.props;
const titleClass = titleSize === 'xl' ? 'text-xl' : 'text-lg';
const Tag = url ? 'a' : 'div';
const linkProps = url ? { href: url, target: '_blank', rel: 'noopener noreferrer' } : {};

const typeLabels = { panel: 'Panel', interview: 'Interview', presentation: 'Presentation' } as const;
---

<Tag {...linkProps} class:list={['group rounded-xl border border-cream-200 bg-white p-6 shadow-sm transition-all duration-300 hover:-translate-y-0.5 hover:shadow-md', url && 'block']}>
  {type && (
    <span class="mb-2 inline-flex items-center gap-1 text-xs font-medium text-warm-gray-400">
      {type === 'panel' && (
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M18 18.72a9.094 9.094 0 003.741-.479 3 3 0 00-4.682-2.72m.94 3.198l.001.031c0 .225-.012.447-.037.666A11.944 11.944 0 0112 21c-2.17 0-4.207-.576-5.963-1.584A6.062 6.062 0 016 18.719m12 0a5.971 5.971 0 00-.941-3.197m0 0A5.995 5.995 0 0012 12.75a5.995 5.995 0 00-5.058 2.772m0 0a3 3 0 00-4.681 2.72 8.986 8.986 0 003.74.477m.94-3.197a5.971 5.971 0 00-.94 3.197M15 6.75a3 3 0 11-6 0 3 3 0 016 0zm6 3a2.25 2.25 0 11-4.5 0 2.25 2.25 0 014.5 0zm-13.5 0a2.25 2.25 0 11-4.5 0 2.25 2.25 0 014.5 0z" />
        </svg>
      )}
      {type === 'interview' && (
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 18.75a6 6 0 006-6v-1.5m-6 7.5a6 6 0 01-6-6v-1.5m6 7.5v3.75m-3.75 0h7.5M12 15.75a3 3 0 01-3-3V4.5a3 3 0 116 0v8.25a3 3 0 01-3 3z" />
        </svg>
      )}
      {type === 'presentation' && (
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 3v11.25A2.25 2.25 0 006 16.5h2.25M3.75 3h-1.5m1.5 0h16.5m0 0h1.5m-1.5 0v11.25A2.25 2.25 0 0118 16.5h-2.25m-7.5 0h7.5m-7.5 0l-1 3m8.5-3l1 3m0 0l.5 1.5m-.5-1.5h-9.5m0 0l-.5 1.5" />
        </svg>
      )}
      {typeLabels[type]}
    </span>
  )}
  <span class="text-sm font-semibold uppercase tracking-wider text-gold-600">
    {event}
  </span>
  <h3 class:list={[titleClass, 'mt-2 font-semibold leading-snug text-warm-gray-900', url && 'transition-colors group-hover:text-gold-700']}>
    {title}
  </h3>
  {role && (
    <span class="mt-2 inline-block rounded-full bg-gold-500/10 px-2.5 py-0.5 text-xs font-medium text-gold-700">
      {role}
    </span>
  )}
  <div class="mt-4 flex flex-wrap items-center gap-x-4 gap-y-1 text-sm text-warm-gray-500">
    <span>{date}</span>
    {location && (
      <span class="flex items-center gap-1">
        <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
        </svg>
        {location}
      </span>
    )}
  </div>
  {url && (
    <div class="mt-3 flex justify-end">
      <svg class="h-4 w-4 text-warm-gray-400 transition-transform group-hover:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
      </svg>
    </div>
  )}
</Tag>
