---
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const navItems = [
  { label: 'Home', href: '/' },
  { label: 'Resume', href: '/resume' },
  { label: 'Press', href: '/press' },
  { label: 'Speaking', href: '/speaking' },
];
---

<header class="sticky top-0 z-50 border-b border-cream-200 bg-cream-50/90 backdrop-blur-md">
  <nav class="mx-auto flex max-w-5xl items-center justify-between px-6 py-4">
    <a href="/" class="text-lg font-semibold tracking-tight text-warm-gray-900 transition-colors hover:text-gold-600">
      Christina Beaumier
    </a>

    <!-- Desktop nav -->
    <div class="hidden items-center gap-1 md:flex">
      <ul class="flex gap-1">
        {navItems.map(({ label, href }) => (
          <li>
            <a
              href={href}
              class:list={[
                'rounded-md px-3 py-2 text-sm font-medium transition-colors',
                currentPath === href
                  ? 'bg-cream-200 text-warm-gray-900'
                  : 'text-warm-gray-600 hover:bg-cream-100 hover:text-warm-gray-900',
              ]}
            >
              {label}
            </a>
          </li>
        ))}
      </ul>
      <a
        href="https://www.linkedin.com/in/christinabeaumier/"
        target="_blank"
        rel="noopener noreferrer"
        class="ml-2 rounded-md p-2 text-warm-gray-600 transition-colors hover:bg-cream-100 hover:text-gold-600"
        aria-label="LinkedIn"
      >
        <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
        </svg>
      </a>
    </div>

    <!-- Mobile menu button -->
    <button
      id="mobile-menu-btn"
      class="inline-flex items-center justify-center rounded-md p-2 text-warm-gray-600 hover:bg-cream-100 hover:text-warm-gray-900 md:hidden"
      aria-label="Toggle menu"
      aria-expanded="false"
    >
      <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path id="menu-icon" stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>
  </nav>

  <!-- Mobile nav -->
  <div id="mobile-menu" class="hidden border-t border-cream-200 md:hidden">
    <ul class="space-y-1 px-4 py-3">
      {navItems.map(({ label, href }) => (
        <li>
          <a
            href={href}
            class:list={[
              'block rounded-md px-3 py-2 text-sm font-medium transition-colors',
              currentPath === href
                ? 'bg-cream-200 text-warm-gray-900'
                : 'text-warm-gray-600 hover:bg-cream-100 hover:text-warm-gray-900',
            ]}
          >
            {label}
          </a>
        </li>
      ))}
      <li>
        <a
          href="https://www.linkedin.com/in/christinabeaumier/"
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-2 rounded-md px-3 py-2 text-sm font-medium text-warm-gray-600 transition-colors hover:bg-cream-100 hover:text-warm-gray-900"
        >
          <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
          </svg>
          LinkedIn
        </a>
      </li>
    </ul>
  </div>
</header>

<script>
  function handleMobileMenu(e: Event) {
    const btn = document.getElementById('mobile-menu-btn');
    const menu = document.getElementById('mobile-menu');
    const expanded = btn?.getAttribute('aria-expanded') === 'true';
    btn?.setAttribute('aria-expanded', String(!expanded));
    menu?.classList.toggle('hidden');
  }

  document.addEventListener('astro:page-load', () => {
    const btn = document.getElementById('mobile-menu-btn');
    btn?.removeEventListener('click', handleMobileMenu);
    btn?.addEventListener('click', handleMobileMenu);
  });
</script>
