---
import type { PressItem } from '../types';

interface Props {
  item: PressItem;
}

const { item } = Astro.props;
---

<a
  href={item.url}
  target="_blank"
  rel="noopener noreferrer"
  class="group flex flex-col rounded-xl border border-cream-200 bg-white p-6 shadow-sm transition-all duration-300 hover:-translate-y-0.5 hover:shadow-md"
>
  <span class="text-sm font-semibold uppercase tracking-wider text-gold-600">
    {item.publication}
  </span>
  <h3 class="mt-2 flex-1 text-lg font-semibold leading-snug text-warm-gray-900 transition-colors group-hover:text-gold-700">
    {item.title}
  </h3>
  <div class="mt-4 flex items-center justify-between">
    <span class="text-sm text-warm-gray-500">{item.date}</span>
    <svg class="h-4 w-4 text-warm-gray-400 transition-transform group-hover:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
    </svg>
  </div>
</a>
