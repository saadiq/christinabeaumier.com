---
interface Props {
  title: string;
  subtitle?: string;
}

const { title, subtitle } = Astro.props;
---

<div class="mb-8">
  <h2 class="text-2xl font-bold tracking-tight text-warm-gray-900 sm:text-3xl">{title}</h2>
  {subtitle && <p class="mt-2 text-warm-gray-500">{subtitle}</p>}
  <div class="mt-3 h-0.5 w-12 bg-gold-500"></div>
</div>
