---
import type { InterviewItem } from '../types';

interface Props {
  item: InterviewItem;
}

const { item } = Astro.props;
---

<div class="rounded-xl border border-cream-200 bg-white shadow-sm">
  <div class="flex aspect-video items-center justify-center rounded-t-xl bg-cream-200">
    <svg class="h-12 w-12 text-warm-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
      <path stroke-linecap="round" stroke-linejoin="round" d="M15.91 11.672a.375.375 0 010 .656l-5.603 3.113a.375.375 0 01-.557-.328V8.887c0-.286.307-.466.557-.327l5.603 3.112z" />
    </svg>
  </div>
  <div class="p-5">
    <span class="text-sm font-semibold uppercase tracking-wider text-gold-600">
      {item.source}
    </span>
    <h3 class="mt-1.5 text-base font-semibold leading-snug text-warm-gray-900">
      {item.title}
    </h3>
    <p class="mt-2 text-sm text-warm-gray-500">{item.date}</p>
  </div>
</div>
