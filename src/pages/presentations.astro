---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import EventCard from '../components/EventCard.astro';
import type { PresentationItem } from '../types';
import presentationsData from '../content/presentations.json';

const presentations = presentationsData as PresentationItem[];
---

<BaseLayout title="Presentations — Christina Beaumier" description="Conference presentations and talks by Christina Beaumier.">
  <section class="py-16 sm:py-20">
    <div class="mx-auto max-w-5xl px-6">
      <PageHeader title="Presentations" />

      <div class="mt-12 grid gap-6 sm:grid-cols-2">
        {presentations.map((item, i) => (
          <div class="animate-on-scroll" style={`transition-delay: ${i * 100}ms`}>
            <EventCard event={item.event} title={item.title} date={item.date} location={item.location} titleSize="xl" />
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
