---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import EventCard from '../components/EventCard.astro';
import type { PanelItem } from '../types';
import panelsData from '../content/panels.json';

const panels = panelsData as PanelItem[];

// Group panels by year
const grouped = panels.reduce<Record<string, PanelItem[]>>((acc, panel) => {
  const year = panel.date.match(/\d{4}/)?.[0] ?? 'Other';
  if (!acc[year]) acc[year] = [];
  acc[year].push(panel);
  return acc;
}, {});

const years = Object.keys(grouped).sort((a, b) => Number(b) - Number(a));
---

<BaseLayout title="Panels — Christina Beaumier" description="Panel appearances and speaking engagements by Christina Beaumier.">
  <section class="py-16 sm:py-20">
    <div class="mx-auto max-w-5xl px-6">
      <PageHeader title="Panels" />

      {years.map((year) => (
        <div class="mt-12">
          <h2 class="animate-on-scroll mb-6 text-xl font-bold text-warm-gray-800">{year}</h2>
          <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {grouped[year].map((item, i) => (
              <div class="animate-on-scroll" style={`transition-delay: ${(i % 3) * 100}ms`}>
                <EventCard event={item.event} title={item.title} date={item.date} location={item.location} role={item.role} url={item.url} />
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>
</BaseLayout>
