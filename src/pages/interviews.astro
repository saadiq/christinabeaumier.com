---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import VideoCard from '../components/VideoCard.astro';
import type { InterviewItem } from '../types';
import interviewsData from '../content/interviews.json';

const interviews = interviewsData as InterviewItem[];
---

<BaseLayout title="Interviews — Christina Beaumier" description="Video interviews and podcast appearances by Christina Beaumier discussing programmatic advertising, convergent TV strategy, and media technology leadership.">
  <section class="py-16 sm:py-20">
    <div class="mx-auto max-w-5xl px-6">
      <PageHeader title="Interviews" />

      <h2 class="sr-only">Video Interviews & Podcasts</h2>
      <div class="mt-12 grid gap-6 sm:grid-cols-2">
        {interviews.map((item, i) => (
          <div class="animate-on-scroll" style={`transition-delay: ${(i % 2) * 100}ms`}>
            <VideoCard item={item} />
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
